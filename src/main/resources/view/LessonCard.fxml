<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox id="lessonCardPane" spacing="5" minWidth="0" maxWidth="Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="10" right="15" bottom="10" left="15" />
  </padding>
  <Label fx:id="lessonHeading" styleClass="cell_big_label" wrapText="true" minWidth="0" maxWidth="Infinity" />
  <Label fx:id="lessonIdentity" styleClass="cell_small_label, card_identity_label"
         wrapText="true" minWidth="0" maxWidth="Infinity" />
  <GridPane hgap="10" vgap="4" styleClass="card_fields" minWidth="0" maxWidth="Infinity">
    <columnConstraints>
      <ColumnConstraints minWidth="95" prefWidth="105" maxWidth="105" />
      <ColumnConstraints minWidth="0" hgrow="ALWAYS" />
    </columnConstraints>
    <Label text="Schedule" styleClass="cell_small_label, card_field_label" wrapText="true"
           minWidth="0" GridPane.rowIndex="0" GridPane.columnIndex="0" />
    <Label fx:id="lessonSchedule" styleClass="cell_small_label, card_field_value" wrapText="true"
           minWidth="0" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1" />
    <Label text="Tutor" styleClass="cell_small_label, card_field_label" wrapText="true"
           minWidth="0" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <Label fx:id="lessonTutor" styleClass="cell_small_label, card_field_value" wrapText="true"
           minWidth="0" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />
    <Label text="Room" styleClass="cell_small_label, card_field_label" wrapText="true"
           minWidth="0" GridPane.rowIndex="2" GridPane.columnIndex="0" />
    <Label fx:id="lessonRoom" styleClass="cell_small_label, card_field_value" wrapText="true"
           minWidth="0" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1" />
    <Label text="Students enrolled" styleClass="cell_small_label, card_field_label" wrapText="true"
           minWidth="0" GridPane.rowIndex="3" GridPane.columnIndex="0" />
    <Label fx:id="lessonRosterSize" styleClass="cell_small_label, card_field_value" wrapText="true"
           minWidth="0" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />
  </GridPane>
  <VBox fx:id="rosterDetails" spacing="5" styleClass="card_section" visible="false" managed="false"
        minWidth="0" maxWidth="Infinity" />
  <VBox fx:id="formerDetails" spacing="5" styleClass="card_section, card_secondary_section"
        visible="false" managed="false" minWidth="0" maxWidth="Infinity" />
</VBox>

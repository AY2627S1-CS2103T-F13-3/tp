<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane" styleClass="person-record-card" spacing="8" minWidth="0" maxWidth="Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="12" right="15" bottom="12" left="15" />
  </padding>
  <VBox spacing="3" minWidth="0" maxWidth="Infinity">
    <Label fx:id="heading" styleClass="person-name" wrapText="true" minWidth="0" maxWidth="Infinity" />
    <Label fx:id="identity" styleClass="person-identity" wrapText="true" minWidth="0" maxWidth="Infinity" />
    <Label fx:id="position" styleClass="person-position" wrapText="true" minWidth="0" maxWidth="Infinity" />
  </VBox>
  <VBox fx:id="details" spacing="8" minWidth="0" maxWidth="Infinity" />
  <VBox fx:id="context" spacing="4" minWidth="0" maxWidth="Infinity" />
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" minWidth="0" maxWidth="Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox alignment="CENTER_LEFT" minHeight="105" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS">
    <padding>
      <Insets top="5" right="5" bottom="5" left="15" />
    </padding>
    <HBox spacing="0.5" alignment="TOP_LEFT" minWidth="0">
      <Label fx:id="id" styleClass="cell_big_label">
        <minWidth>
          <!-- Ensures that the displayed position is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="name" styleClass="cell_big_label" wrapText="true" minWidth="0"
             maxWidth="Infinity" HBox.hgrow="ALWAYS" />
    </HBox>
    <VBox fx:id="tags" minWidth="0" fillWidth="false" spacing="3" />
    <Label fx:id="phone" styleClass="cell_small_label" wrapText="true" minWidth="0" maxWidth="Infinity" />
    <Label fx:id="address" styleClass="cell_small_label" wrapText="true" minWidth="0" maxWidth="Infinity" />
    <Label fx:id="email" styleClass="cell_small_label" wrapText="true" minWidth="0" maxWidth="Infinity" />
  </VBox>
</HBox>

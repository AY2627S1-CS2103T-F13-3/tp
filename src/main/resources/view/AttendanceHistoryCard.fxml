<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox id="attendanceHistoryCardPane" spacing="5" minWidth="0" maxWidth="Infinity"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="10" right="15" bottom="10" left="15" />
  </padding>
  <Label fx:id="attendanceDate" styleClass="cell_big_label" wrapText="true"
         minWidth="0" maxWidth="Infinity" />
  <Label fx:id="attendanceIdentity" styleClass="cell_small_label, card_identity_label"
         wrapText="true" minWidth="0" maxWidth="Infinity" />
  <GridPane hgap="10" vgap="4" styleClass="card_fields" minWidth="0" maxWidth="Infinity">
    <columnConstraints>
      <ColumnConstraints minWidth="70" prefWidth="80" maxWidth="80" />
      <ColumnConstraints minWidth="0" hgrow="ALWAYS" />
    </columnConstraints>
    <Label text="Status" styleClass="cell_small_label, card_field_label" wrapText="true"
           minWidth="0" GridPane.rowIndex="0" GridPane.columnIndex="0" />
    <Label fx:id="attendanceStatus" styleClass="cell_small_label, card_field_value" wrapText="true"
           minWidth="0" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1" />
    <Label text="Membership" styleClass="cell_small_label, card_field_label" wrapText="true"
           minWidth="0" GridPane.rowIndex="1" GridPane.columnIndex="0" />
    <Label fx:id="attendanceMembership" styleClass="cell_small_label, card_field_value" wrapText="true"
           minWidth="0" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />
  </GridPane>
</VBox>

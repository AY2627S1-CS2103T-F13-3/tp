@startuml
!include style.puml
!pragma layout elk

' Widen the central class for distinct association endpoints.
' The layout-only stereotype is hidden from the rendered UML.
<style>
classDiagram {
  .layoutHub {
    MinimumWidth 240
    RoundCorner 0
  }
}
</style>

skinparam defaultFontSize 16
skinparam classFontSize 16
skinparam classAttributeFontColor #FFFFFF
skinparam ArrowFontSize 16
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

class PonHubDataState

class Student

class Lesson

class Attendance <<layoutHub>>
hide <<layoutHub>> stereotype
class AttendanceKey
class AttendanceStatus <<enumeration>> {
    PRESENT
    ABSENT
}
show AttendanceStatus fields
hide AttendanceStatus methods

PonHubDataState "<U+00A0>0..*" --> "<U+00A0>0..*" Attendance : ordered records
Attendance "<U+00A0>0..*" --> "<U+00A0>1" AttendanceKey : key
Attendance "<U+00A0>0..*" --> "<U+00A0>1" AttendanceStatus : status
Attendance "<U+00A0>0..*" --> "<U+00A0>1" Student : studentId\n(PersonId)
Attendance "<U+00A0>0..*" --> "<U+00A0>1" Lesson : lessonId\n(LessonId)

@enduml

@startuml
!include style.puml
!pragma layout smetana

skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package "Canonical aggregate" {
    class PonHubDataState
}

package "People" {
    class Student
}

package "Shared lessons" {
    class Lesson
}

package "Dated attendance" {
    class Attendance
    class AttendanceKey
    class AttendanceStatus <<enumeration>>
}

PonHubDataState "0..*" --> "0..*" Attendance : ordered records
Attendance "0..*" --> "1" AttendanceKey : key
Attendance "0..*" --> "1" AttendanceStatus : status
Attendance "0..*" --> "1" Student : studentId (PersonId)
Attendance "0..*" --> "1" Lesson : lessonId (LessonId)

note as AttendanceNotes
  Attendance notes:
  • Unique key: Student ID + Lesson ID + LocalDate.
  • Attendance is dated history, separate from current membership.
  • It remains valid after a Student is unenrolled from a Lesson.
end note

@enduml

@startuml
!include style.puml
!pragma layout smetana

skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package "Canonical aggregate" {
    class PonHubDataState
}

package "People" {
    class Student
}

package "Shared lessons" {
    class Lesson
}

package "Dated attendance" {
    class Attendance
    class AttendanceKey
    enum AttendanceStatus
}

PonHubDataState "1" *-- "0..*" Attendance : ordered records
Attendance "1" *-- "1" AttendanceKey : key
Attendance "1" *-- "1" AttendanceStatus : status
Attendance "0..*" --> "1" Student : studentId (PersonId)
Attendance "0..*" --> "1" Lesson : lessonId (LessonId)

note right of AttendanceKey
  Unique key:
  Student ID + Lesson ID + LocalDate
end note

note bottom of Attendance
  Attendance is dated history, separate from current membership.
  It remains valid after a Student is unenrolled from a Lesson.
end note

@enduml

@startuml
' Updated by Ernest Chua with OpenAI Codex assistance (#220).
!pragma layout smetana
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
component "UI\nCommands, observable views, feedback" as UI #E1F2DC
component "Logic\nRouting and transaction coordination" as Logic #E5E5FA
component "Model\nCanonical records, invariants, projections" as Model #FBE3E6
component "Storage\nProtected loading and snapshot persistence" as Storage #FFF0BD
component "MainApp\nStartup wiring and separate preferences" as Main #EEEEEE
Main ..> UI : wires
Main ..> Logic : wires
UI --> Logic : Logic API
Logic --> Model : stage / query / publish
Logic --> Storage : load / save snapshot
Storage ..> Model : canonical snapshot types
legend bottom
  Solid arrow: runtime call dependency
  Dashed arrow: wiring or type dependency
  Shared Commons helpers omitted for clarity.
endlegend
@enduml

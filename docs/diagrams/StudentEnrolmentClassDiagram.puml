@startuml
' Draft by Vincent Lin with OpenAI Codex assistance.
' Self-contained source; render with PlantUML 1.2025.3.
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFF2F3
skinparam classBorderColor #9D0012
skinparam classArrowColor #9D0012
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #777777
skinparam nodesep 45
skinparam ranksep 45
hide circle
hide empty members

class PonHubData {
  + enrolStudent(studentId, lessonId)
  + getLessonRoster(lessonId)
}
class PonHubDataState <<immutable snapshot>> {
  people : PeopleRegistryState
}
class Lesson <<immutable>> {
  id : LessonId
  enrolledStudentIds : Set<PersonId>
}
class LessonRetrieval {
  - buildDetail(lesson, date)
}

PonHubData "0..*" -down-> "1<U+00A0><U+00A0>" PonHubDataState : current state
PonHubDataState "0..*" -down-> "0..*" Lesson : lessons
LessonRetrieval -left-> "1<U+00A0><U+00A0>" PonHubData : reads roster,\nobserves changes

note as RosterRule
  Zero or more unique Student IDs.
  The set is unmodifiable.
end note
Lesson .right. RosterRule
@enduml

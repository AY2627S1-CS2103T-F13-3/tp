@startuml
' Draft by Vincent Lin with OpenAI Codex assistance.
' Self-contained source; render with PlantUML 1.2025.3.
' Command and transaction helper calls are grouped as operation descriptions.
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #FFF2F3
skinparam sequenceParticipantBorderColor #9D0012
skinparam sequenceLifeLineBorderColor #777777
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #777777
hide footbox

title Enrolment flow (helper calls grouped)
participant "executor:\nCanonicalCommandExecutor" as Logic
participant "candidate:\nPonHubData" as Candidate
participant "writer:\nSnapshotWriter" as Storage
participant "live:\nPonHubData" as Live
participant "queries:\nLessonQueries" as Queries

Logic -> Candidate : Stage enrolment for S7 in L1
note over Candidate
  Validate enrolment;
  replace the lesson roster.
end note
Logic -> Storage : save complete snapshot
Storage --> Logic : saved
Logic -> Live : publish snapshot
Live -> Queries : refresh roster results
@enduml

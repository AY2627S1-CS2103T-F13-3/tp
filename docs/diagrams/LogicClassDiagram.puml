@startuml
' Updated by Ernest Chua with OpenAI Codex assistance (#220).
!pragma layout smetana
hide empty members
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
interface Logic #E1F2DC {
  execute(commandText)
  observable retrieval API
}
class CanonicalLogicManager #E5E5FA
class CanonicalPeopleSession #E5E5FA {
  execute(commandText)
  protection, parsing and dispatch
}
class CanonicalCommandExecutor #E5E5FA {
  execute(command)
  save changed snapshot before commit
}
interface "CanonicalCommandExecutor.\nStagedCommand" as StagedCommand #E5E5FA {
  execute(staged, stagedView)
}
class CanonicalTransaction #FBE3E6 {
  getStagedModel()
  getStagedPeopleView()
  hasOperationalChanges()
  commit()
}
interface "CanonicalCommandExecutor.\nSnapshotWriter" as Writer #FFF0BD {
  save(state)
}
CanonicalLogicManager ..|> Logic
CanonicalLogicManager --> CanonicalPeopleSession : delegates
CanonicalPeopleSession --> CanonicalCommandExecutor : mutations / list
CanonicalCommandExecutor ..> StagedCommand : calls on isolated copies
CanonicalCommandExecutor ..> CanonicalTransaction : obtains via PeopleView
CanonicalCommandExecutor --> Writer : injected callback
CanonicalTransaction -[hidden]-> Writer
legend bottom
  Solid arrow: retained collaborator
  Dashed arrow: use; hollow triangle: implements
  Only command-boundary collaborators are shown.
endlegend
@enduml

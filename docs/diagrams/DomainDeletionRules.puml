@startuml
' Simplified domain draft by Vincent Lin with OpenAI Codex assistance.
' Self-contained source; renderer: PlantUML 1.2025.3.
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFF2F3
skinparam classBorderColor #9D0012
skinparam classArrowColor #9D0012
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #777777
skinparam nodesep 35
skinparam ranksep 40

skinparam activityBackgroundColor #FFF2F3
skinparam activityBorderColor #9D0012
skinparam activityDiamondBackgroundColor #FFFBE6
skinparam conditionStyle diamond
start
:Check target for stored references;
if () then ([referenced])
  :Reject deletion;
else ([else])
  :Allow staged deletion;
endif
stop
@enduml

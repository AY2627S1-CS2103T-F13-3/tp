@startuml
' Simplified domain draft by Vincent Lin with OpenAI Codex assistance.
' Self-contained source; renderer: PlantUML 1.2025.3.
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFF2F3
skinparam classBorderColor #9D0012
skinparam classArrowColor #9D0012
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #777777
skinparam nodesep 35
skinparam ranksep 40

title One student, lesson and date
skinparam stateBackgroundColor #FFF2F3
skinparam stateBorderColor #9D0012
state "Enrolled\nNo attendance record" as A
state "Enrolled\nAttendance recorded" as B
state "Unenrolled\nAttendance retained" as C
state "Unenrolled\nNo attendance record" as D
A -down-> B : mark
B -down-> C : unenrol
C -down-> D : unmark
@enduml

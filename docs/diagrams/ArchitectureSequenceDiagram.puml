@startuml
' Readability layout by Zhu Zhi Yu with OpenAI Codex assistance (#393).
' Updated by Ernest Chua with OpenAI Codex assistance (#220).
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 140
skinparam ParticipantPadding 8
participant "session" as Session #E5E5FA
participant "executor" as Executor #E5E5FA
participant "transaction" as Tx #FBE3E6
participant "writer" as Writer #FFF0BD
[-> Session : execute(...)
Session -> Session : resolve; check protection;\nparse; create command
Session -> Executor : execute(command)
Executor -> Executor : view.beginTransaction()
ref over Executor, Tx
  command.execute(staged, stagedView)
  Resolve index; validate; stage edit.
  Return prepared CommandResult.
end ref
Executor -> Tx : hasOperationalChanges()
Tx --> Executor : changed
alt changed operational snapshot
  Executor -> Writer : save(staged.exportState())
  alt save succeeds
    Writer --> Executor : saved
  else permission / I/O failure
    Writer --> Executor : IOException
  end
else no operational change
  note over Executor, Tx : Skip save; a view-only change may still commit.
end
alt no operational change or save succeeded
  Executor -> Tx : commit()
  Tx -> Tx : publish root, then people filter;\nrefresh views
  Tx --> Executor
  Executor --> Session : CommandResult
  [<-- Session : success feedback
else save failed
  Executor --> Session : CommandException
  [<-- Session : failure feedback
end
@enduml

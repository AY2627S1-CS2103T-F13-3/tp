@startuml
' Simplified domain draft by Vincent Lin with OpenAI Codex assistance.
' Self-contained source; renderer: PlantUML 1.2025.3.
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFF2F3
skinparam classBorderColor #9D0012
skinparam classArrowColor #9D0012
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #777777
skinparam nodesep 35
skinparam ranksep 40
hide circle
hide empty members

title People share one record interface
interface PersonRecord <<interface>> {
  + getId() : PersonId
  + getContactDetails() : ContactDetails
}
class Student {
  educationLevel : EducationLevel
  parentPhone : Phone
}
class Tutor
class Parent
Student .up.|> PersonRecord
Tutor .up.|> PersonRecord
Parent .up.|> PersonRecord
@enduml

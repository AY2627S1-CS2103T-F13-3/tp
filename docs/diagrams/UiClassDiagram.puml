@startuml
' Renderer: PlantUML 1.2025.3, using the committed style.puml unchanged.
' From the repository root:
' java -jar plantuml-1.2025.3.jar -charset UTF-8 -tpng -o ../images docs/diagrams/UiClassDiagram.puml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam nodesep 30
skinparam ranksep 45
skinparam linetype polyline

package UI as UiPackage {
    class "<<interface>>\nUi" as UiApi
    class UiManager
    class MainWindow
    class ResultDisplay
    class CommandBox
    class StatusBarFooter
    class PersonRecordListPanel
    class LessonListPanel
    class HistoryListPanel
    class PersonRecordCard
    class LessonCard
    class AttendanceHistoryCard
}
package Logic as LogicPackage {
    class "<<interface>>\nLogic" as LogicApi LOGIC_COLOR
}

UiManager .left.|> UiApi
UiManager .down.> MainWindow
UiManager -[norank]-> LogicApi
MainWindow -[norank]-> LogicApi

MainWindow --> ResultDisplay
MainWindow ..> CommandBox
MainWindow ..> StatusBarFooter
MainWindow --> PersonRecordListPanel
MainWindow ..> LessonListPanel
MainWindow ..> HistoryListPanel

PersonRecordListPanel ..> PersonRecordCard
LessonListPanel ..> LessonCard
HistoryListPanel ..> AttendanceHistoryCard

legend bottom left
  Dashed dependencies: creates
  MainWindow, its six components, and the three cards
  all extend abstract UiPart (inheritance arrows omitted).
endlegend
@enduml

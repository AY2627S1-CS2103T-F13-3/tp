@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam nodesep 25
skinparam ranksep 40

package UI as UiPackage {
    class "<<interface>>\nUi" as UiApi
    abstract class UiPart
    class UiManager
    class MainWindow
    class ResultDisplay
    class PersonRecordListPanel
    class PersonRecordCard
    class LessonListPanel
    class LessonCard
    class HistoryListPanel
    class AttendanceHistoryCard
    class StatusBarFooter
    class CommandBox
}
package Logic as LogicPackage {
    class "<<interface>>\nLogic" as LogicApi LOGIC_COLOR
}

UiManager ..|> UiApi
UiManager ..> MainWindow : creates
UiManager --> LogicApi
MainWindow --> LogicApi
MainWindow --> ResultDisplay
MainWindow --> PersonRecordListPanel
MainWindow ..> CommandBox : creates
MainWindow ..> LessonListPanel : creates
MainWindow ..> HistoryListPanel : creates
MainWindow ..> StatusBarFooter : creates

PersonRecordListPanel ..> PersonRecordCard : creates
LessonListPanel ..> LessonCard : creates
HistoryListPanel ..> AttendanceHistoryCard : creates

MainWindow --|> UiPart
ResultDisplay --|> UiPart
CommandBox --|> UiPart
PersonRecordListPanel --|> UiPart
PersonRecordCard --|> UiPart
LessonListPanel --|> UiPart
LessonCard --|> UiPart
HistoryListPanel --|> UiPart
AttendanceHistoryCard --|> UiPart
StatusBarFooter --|> UiPart
@enduml

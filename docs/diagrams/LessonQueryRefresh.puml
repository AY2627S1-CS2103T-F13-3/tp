@startuml
' Readability layout by Zhu Zhi Yu with OpenAI Codex assistance (#393).
!include style.puml
skinparam ParticipantFontColor #FFFFFF
skinparam sequenceMessageAlign left
skinparam defaultFontSize 16
skinparam maxMessageSize 105
skinparam ParticipantPadding 5
skinparam ArrowFontSize 16
participant "executor" as executor LOGIC_COLOR
participant "tx" as transaction MODEL_COLOR
participant "writer" as writer STORAGE_COLOR
participant "root" as live MODEL_COLOR
participant "queries" as queries MODEL_COLOR
participant "retrieval" as retrieval LOGIC_COLOR

executor -> transaction : prepare editlesson\nlid/L1 s/English
executor -> writer : save candidate snapshot
alt save fails
    writer --> executor : IOException
else save succeeds
    writer --> executor : saved
    executor -> transaction : commit()
    transaction -> live : resetData(candidate)
    live -> queries : stateProperty change
    activate queries
    queries -> queries : rebuild derived indexes
    queries -> queries : refresh lists / active filter
    queries -> retrieval : filtered list becomes []
    retrieval -> retrieval : replace display entries
    retrieval --> queries : display refreshed
    queries --> live : query refresh complete
    deactivate queries
    transaction --> executor : committed
end
@enduml

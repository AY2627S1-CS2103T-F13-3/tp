@startuml
' Simplified domain draft by Vincent Lin with OpenAI Codex assistance.
' Self-contained source; renderer: PlantUML 1.2025.3.
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFF2F3
skinparam classBorderColor #9D0012
skinparam classArrowColor #9D0012
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #777777
skinparam nodesep 35
skinparam ranksep 40

title Resolve a displayed position once
skinparam sequenceParticipantBackgroundColor #FFF2F3
skinparam sequenceParticipantBorderColor #9D0012
hide footbox
participant Command
participant PeopleView as View
participant PersonIndexResolver as Resolver
Command -> View : getPeople()
View --> Command : [S4, S9]
Command -> Resolver : resolveStudent(2, people)
Resolver --> Command : Student with ID S9
@enduml

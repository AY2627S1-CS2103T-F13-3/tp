@startuml
' Simplified domain draft by Vincent Lin with OpenAI Codex assistance.
' Self-contained source; renderer: PlantUML 1.2025.3.
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #FFF2F3
skinparam classBorderColor #9D0012
skinparam classArrowColor #9D0012
skinparam noteBackgroundColor #FFFBE6
skinparam noteBorderColor #777777
skinparam nodesep 35
skinparam ranksep 40
hide circle
hide empty members

title A complete operational snapshot
class PonHubDataState <<immutable>> {
  lessons : List<Lesson>
  attendance : List<Attendance>
  lastAllocatedLessonSequence : long
}
class PeopleRegistryState <<immutable>> {
  people : List<PersonRecord>
  lastAllocatedSequences : Map<PersonRole, Long>
}
PonHubDataState "0..*" -down-> "1" PeopleRegistryState : people
@enduml
